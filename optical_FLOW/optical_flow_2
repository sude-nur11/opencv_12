# burda amac iki frameyi birbiriyle karşılaştırarak nesne takip uygulamaları yapmak
import cv2
import numpy as np

cap = cv2.VideoCapture(0)

ret, frame1 = cap.read()
prevImg = cv2.cvtColor(frame1, cv2.COLOR_BGR2GRAY)

# HSV maske (renkli akış çizimi için)
hsv_mask = np.zeros_like(frame1)
hsv_mask[:, :, 1] = 255  # Doygunluk tam

while True:
    # Yeni frame
    ret, frame2 = cap.read()
    nextImg = cv2.cvtColor(frame2, cv2.COLOR_BGR2GRAY)

    # Optical Flow hesapla (Farneback)
    flow = cv2.calcOpticalFlowFarneback(prevImg, nextImg, None,
                                        0.5, 3, 15, 3, 5, 1.2, 0)
    # Akışın büyüklük ve açısını al
    mag, ang = cv2.cartToPolar(flow[:, :, 0], flow[:, :, 1], angleInDegrees=True)
    # HSV'de açı -> renk
    hsv_mask[:, :, 0] = ang / 2
    # Büyüklük -> parlaklık
    hsv_mask[:, :, 2] = cv2.normalize(mag, None, 0, 255, cv2.NORM_MINMAX)
    bgr = cv2.cvtColor(hsv_mask, cv2.COLOR_HSV2BGR)

    cv2.imshow('frame2', bgr)

    k = cv2.waitKey(30) & 0xFF
    if k == 27:
        break

    # Bir sonraki döngü için frame'i kaydır
    prevImg = nextImg

cap.release()
cv2.destroyAllWindows()
